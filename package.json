{
  "name": "test_next_custom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stack": "GATEWAY_PORT=8090 docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch api py worker redis gateway",
